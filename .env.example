# ====================================================================
# PS26108 — Backend Environment Configuration (.env.example)
# For Render Deployment & Local Development
# ====================================================================

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Server & Port Binding
# Render dynamically injects the PORT environment variable
PORT=8000
API_HOST=0.0.0.0
API_PORT=8000

# Frontend CORS Configuration
# Set FRONTEND_URL to your Vercel frontend domain (e.g. https://ps26108.vercel.app)
FRONTEND_URL=
# Comma-separated list of additional allowed origins (e.g. for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Render PostgreSQL Database Connection
# Connect to your Render PostgreSQL instance (e.g. ps26108-db)
# Internal URL (on Render): postgresql://ps26108_user:<password>@dpg-xxxx-a:5432/ps26108_db
# External URL (local): postgresql://ps26108_user:<password>@dpg-xxxx-a.oregon-postgres.render.com/ps26108_db
DATABASE_URL=postgresql://ps26108_user:ps26108_pass@localhost:5432/ps26108_db

# AI Pipeline Models (Lazy loaded on first request)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Dataset Paths
SEED_DATASET_PATH=PS26108_Seed_Dataset_v1.xlsx
PROCESSED_DIR=data/processed
SYNTHETIC_DIR=data/synthetic
EVALUATION_DIR=data/evaluation
EMBEDDINGS_DIR=data/embeddings
