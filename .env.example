# ====================================================================
# PS26108 — Environment Configuration (.env.example)
# ====================================================================

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Database Connection
# Local fallback uses SQLite (data/ps26108_local.db) if PostgreSQL is not set.
DATABASE_URL=postgresql://ps26108_user:ps26108_pass@localhost:5432/ps26108_db

# AI Pipeline Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Dataset Paths
SEED_DATASET_PATH=PS26108_Seed_Dataset_v1.xlsx
PROCESSED_DIR=data/processed
SYNTHETIC_DIR=data/synthetic
EVALUATION_DIR=data/evaluation
EMBEDDINGS_DIR=data/embeddings

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Frontend (Vite)
VITE_API_BASE_URL=
